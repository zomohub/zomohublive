<script>
	jQuery(document).ready(function($) {
		$(document).on("click",".going-to-event",function(event) {
			var event_id = $(this).attr('data-event-ident');
			$.ajax({
				url: Wo_Ajax_Requests_File(),
				type: 'GET',
				dataType: 'json',
				data: {f: 'going-to-event',eid:event_id},
				success:function(data){
					if (data['status'] == 200) {
						$("[data-event="+ event_id +"]").find('.events-list-dropup-menu').html("<span class='main'>"+data['html'] +"</span>")
					}
				}
			})
			
		});

		$(document).on("click",".interested-in-event",function(event) {
			var event_id = $(this).attr('data-event-ident');
			$.ajax({
				url: Wo_Ajax_Requests_File(),
				type: 'GET',
				dataType: 'json',
				data: {f: 'interested-in-event',eid:event_id},
				success:function(data){
					if (data['status'] == 200) {
						$("[data-event="+ event_id +"]").find('.events-list-dropup-menu').html("<span class='main'>"+data['html'] +"</span>")

					}
				}
			})
		});

		$(document).on("click",".events-going-list-unset",function(event) {
			var event_id = $(this).attr('data-event-ident');
			$.ajax({
				url: Wo_Ajax_Requests_File(),
				type: 'GET',
				dataType: 'json',
				data: {f: 'notgoing-to-event',eid:event_id},
				success:function(data){
					if (data['status'] == 200) {
						$("[data-event="+event_id+"]").slideUp('fast', function() {
							$(this).remove()
						});
					}
				}
			})
		});

		let eventCount = 10; // Initialize to 10 if the initial 10 items are already loaded on page load

$(".load-more-events").click(function(event) {
    let type = $(this).attr('data-events-type');
    
    console.log("Sending AJAX with offset:", eventCount); // Log offset for debugging

    $.ajax({
        url: Wo_Ajax_Requests_File(),
        type: 'GET',
        dataType: 'json',
        data: {
            f: 'load-more-events',
            s: type,
            offset: eventCount // Send the correct offset
        },
        success: function(data) {
            console.log("Received data:", data);

            if (data.status === 200) {
                // Append only the newly fetched events
                $("#events-" + type).append(data.html);

                // Increment eventCount by the actual number of newly loaded events
                eventCount += data.count;
                console.log("Updated eventCount:", eventCount); // Log the updated count

                // Hide "Load More" if there are no further events
                if (data.is_last_page) {
                    $(".load-more-events").hide(); // Hide button if it’s the last page
                }
            } else {
                $(".posts_load").find('.load-more').html(data.html); // Show message if no more events
            }
        }
    });
});










	});
</script>