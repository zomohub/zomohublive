<script>

document.addEventListener("DOMContentLoaded", function() {
    // Convert PHP poll_dates array to JavaScript
    let disabledRanges = <?php echo !empty($poll_dates) ? json_encode($poll_dates) : '[]'; ?>.map(range => ({
        start: moment(range.start_date, "YYYY-MM-DD"),
        end: moment(range.end_date, "YYYY-MM-DD")
    }));

    // Check if a date is within any disabled range
    function isDateInDisabledRange(date) {
        return disabledRanges.some(range => date.isBetween(range.start, range.end, null, '[]'));
    }

    // Get the nearest disabled range start date after the selected start date
    function getNearestDisabledRangeStart(startDate) {
        let nearestStartDate = null;
        disabledRanges.forEach(range => {
            if (range.start.isAfter(startDate) && (!nearestStartDate || range.start.isBefore(nearestStartDate))) {
                nearestStartDate = range.start.clone();
            }
        });
        return nearestStartDate;
    }

    // Initialize the Daterangepicker
    $('#poll_dates').daterangepicker({
        autoApply: true,
        minDate: moment(),
        isInvalidDate: function(date) {
            return isDateInDisabledRange(date);
        },
        locale: {
            format: 'YYYY-MM-DD'
        }
    });

    // Restrict the end date based on nearest disabled range
    $('#poll_dates').on('apply.daterangepicker', function(ev, picker) {
        let startDate = picker.startDate;
        let userSelectedEndDate = picker.endDate;
        let nearestDisabledStart = getNearestDisabledRangeStart(startDate);

        // Check if there's a disabled date between the start date and the user-selected end date
        if (nearestDisabledStart && userSelectedEndDate.isSameOrAfter(nearestDisabledStart)) {
            // If a disabled date range exists, adjust end date to the day before the nearest disabled start date
            let maxEndDate = nearestDisabledStart.clone().subtract(1, 'days');
            picker.setEndDate(maxEndDate.isAfter(startDate) ? maxEndDate : startDate);
        } else {
            // No disabled date range found, apply the user-selected end date
            picker.setEndDate(userSelectedEndDate);
        }

        // Update the input field with the final selected date range
        $('#poll_dates').val(startDate.format('YYYY-MM-DD') + ' - ' + picker.endDate.format('YYYY-MM-DD'));
    });
});





$(function() {
    var form_add_settings = $('form.add-settings');
    form_add_settings.ajaxForm({
        url: Wo_Ajax_Requests_File() + '?f=admin_setting&s=add_new_poll',
        beforeSend: function() {
            form_add_settings.find('.waves-effect').text('Please wait..');
        },
        success: function(data) {
            if (data.status == 200) {
                $("html, body").animate({ scrollTop: 0 }, "slow");
                $('.add-settings-alert').html('<div class="alert alert-success"><i class="fa fa-check"></i> Poll added successfully</div>');
                setTimeout(function () {
		            window.location.href = '<?php echo Wo_LoadAdminLinkSettings('manage-polls'); ?>';
		        }, 1000);
            } else if (data.status == 400) {
                $('.add-settings-alert').html('<div class="alert alert-danger">'+data.message+'</div>');
                setTimeout(function () {
                    $('.add-settings-alert').empty();
                }, 2000);
	        }
	        form_add_settings.find('.waves-effect').text('Create');
        }
    });
});

</script>

<script type="text/javascript">
    $(document).ready(function(){
        let fieldIndex = 0;

        // Add new field
        $('#add_button').click(function(e){
            e.preventDefault();
            fieldIndex++;
            let newField = `
                <div class="row dynamic-field mb-2" id="field_${fieldIndex}">
                    <div class="col-md-8">
                        <input type="text" name="poll_answer[]" class="form-control" placeholder="Add Answer" required>
                    </div>
                    <div class="col-md-4">
                        <button class="remove_button btn btn-primary" data-field-id="${fieldIndex}">Remove</button>
                    </div>
                </div>
            `;
            $('#dynamic_field_container').append(newField);
        });

        // Remove field
        $(document).on('click', '.remove_button', function(e){
            e.preventDefault();
            let fieldId = $(this).data('field-id');
            $('#field_' + fieldId).remove();
        });
    });
</script>